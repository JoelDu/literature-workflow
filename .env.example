# ══════════════════════════════════════════════════════════════════════════
# 复制本文件为 .env，填好第 1 段的 API Key 就能跑起来。
# 其余各段都有能用的默认值，不确定就别动。
#
# .env 同时被两边读取，注意区分：
#   · docker-compose.yml —— 只用第 2 段「部署环境」做变量替换；
#   · 宿主机侧的 CLI / nightly_index.py / mcp_server.py —— 用其余各段。
# 容器内部的工作目录（./input_pdfs 等）已在 compose 里写死，本文件改不动它们；
# 要换数据存放位置请改 DATA_ROOT。
# ══════════════════════════════════════════════════════════════════════════

# ── 1. API Key（必填）──────────────────────────────────────────────────
# MinerU 在线 API：把 PDF 解析成 markdown。https://mineru.net 注册后在控制台取
MINERU_API_KEY=your_mineru_api_key_here

# 硅基流动仅用于在线向量嵌入与重排序，必填。
# https://cloud.siliconflow.cn 注册后在「API 密钥」页新建
SILICONFLOW_API_KEY=your_siliconflow_key
SILICONFLOW_API_BASE=https://api.siliconflow.cn/v1
# OpenAI：论文分析、元数据补缺和证据筛选固定 gpt-5.4-mini；综述正文固定 gpt-5.4。
# 不要把真实 key 提交到 git 或贴进聊天。
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_API_BASE=https://api.openai.com/v1

# 仅兼容历史任务或旧部署；新任务不使用，可留空。
DEEPSEEK_API_KEY=
# Gemini 通道已于 2026-09-27 移除，此项不再被任何流程读取。
GEMINI_API_KEY=

# ── 2. 部署环境（docker-compose.yml 用）───────────────────────────────
# 数据盘根目录。compose 里所有挂载都是它的子目录，换机器只改这一个。
# 默认 ./data = 仓库内，clone 下来就能跑；数据大了可指向别的盘，如 /mnt/data/lit
DATA_ROOT=./data

# vault 目录名（DATA_ROOT 下的一级子目录）。默认 obsidian_vault，可改成中文名
OBSIDIAN_VAULT_DIRNAME=obsidian_vault

# 容器名。一台机器只跑一套时不用管。
# 要跑多套（如「自己用」+「给别人用」各一份）必须给每套起不同的名字：容器名全局唯一，
# 重名的第二套会直接报 name is already in use 起不来。
# ⚠️ 改名的同时务必改 DATA_ROOT —— 只改名不改数据目录，两套会共用同一个数据库和 vault，
# 互相覆盖对方的处理记录，比起不来严重得多。
CONTAINER_NAME=lit_analyzer

# 容器网络模式。默认 bridge，绝大多数机器直接用。
# 只有当宿主机防火墙拦 docker 网桥→宿主机端口、导致容器完全断网时才改成 host
# （典型症状：容器里 curl 任何外网地址都超时，宿主机上却正常）。
DOCKER_NETWORK_MODE=bridge

# 构建期网络。构建时要 git clone caj2pdf，直连机器用 default。
# 只有当出网必须过宿主机回环代理时才改 host —— 注意 Docker Desktop（Mac/Windows）
# 不支持构建期 host 网络，那边只能用 default。
DOCKER_BUILD_NETWORK=default

# 可选的共享 Key 文件，会覆盖本文件里的同名项。多个项目共用一份 Key 时才需要。
# 文件不存在不影响启动，不用就留空或删掉本行。
SHARED_ENV_FILE=

# 容器用的 HTTP/HTTPS 代理。OpenAI API 需要通过它翻墙；留空时 compose 会继承
# 宿主机的 HTTP_PROXY / HTTPS_PROXY。ALL_PROXY（尤其 socks5）会被故意屏蔽，避免 SDK
# 因缺少 socks 支持而在启动时失败。bridge 网络下代理地址必须能从容器访问。
LIT_HTTP_PROXY=
LIT_HTTPS_PROXY=
TZ=Asia/Shanghai

# ── 3. 运行调度 ───────────────────────────────────────────────────────
# 运行模式: realtime (定时扫描) 或 batch (定时打包打卡)
RUN_MODE=batch
# 实时模式扫描间隔（分钟）
SCAN_INTERVAL_MINUTES=10
# Batch 模式及时入库调度（间隔驱动；旧的 BATCH_PREPARE_TIME/BATCH_FETCH_TIME_* 已废弃）
BATCH_SCAN_INTERVAL_MINUTES=30
BATCH_FETCH_INTERVAL_MINUTES=120

# 运行日志按天落在 <DB_PATH 所在目录>/app-YYYY-MM-DD.log，超过保留天数的自动删除。
# 设 0 = 永久保留（此前是单个只增不减的 app.log，跑几个月就没法翻了）。
LOG_RETENTION_DAYS=30

# 消息推送配置 (可选，填入 Server酱 / Bark / 飞书 / 钉钉 的 webhook URL)
WEBHOOK_URL=

# ── 4. 综述生成器 (litreview) ─────────────────────────────────────────
# 嵌入后端。
#   remote = 走硅基流动在线 API，任何机器都跑得动，默认值。
#   local  = 用本机 GPU/CPU 跑 LOCAL_EMBEDDING_MODEL_PATH 指向的模型，容器内的
#            build_index 变成只报待办不干活，实际嵌入交给宿主机定时任务。
#            8B 模型嵌一篇论文约 24 分钟、占 15G 内存 —— 内存低于 32G 的机器
#            （含绝大多数云服务器）设 local 等于永远建不出索引，别碰。
REVIEW_EMBED_BACKEND=remote
# 仅 REVIEW_EMBED_BACKEND=local 时有意义：本地嵌入模型的路径
LOCAL_EMBEDDING_MODEL_PATH=
# 仅本地夜间嵌入任务用：跑到这个点收工，把机器让给白天的活
NIGHTLY_INDEX_DEADLINE=08:00

# 嵌入模型（Qwen3-Embedding 跨中英检索强；换模型后需 review.py index --force 重建）
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
EMBEDDING_DIM=4096
# 重排序（向量召回 RERANK_CANDIDATES 条 → rerank 取 top-k，显著提升相关性排序）
# 语料变大（如加入教材）后建议调大 RERANK_CANDIDATES（如 150），给重排器更多候选以保准确率
RERANK_MODEL=Qwen/Qwen3-Reranker-8B
RERANK_ENABLE=true
RERANK_CANDIDATES=50
# 综述写作固定使用 GPT-5.4；代码会锁定此值，防止意外换模型。
REVIEW_MODEL=gpt-5.4
# 导出后自动增量更新向量索引 + 结构化元数据（enrich）
REVIEW_AUTO_INDEX=true
REVIEW_ENRICH_LLM=true
# 每章先从重排结果保留 50 条候选，再由 GPT 逐条打分；下列值是最终每章保留数。
REVIEW_TOP_K=50
# 证据保留门槛（1-10 分）与每章节保留条数
REVIEW_MIN_SCORE=6
REVIEW_EVIDENCE_N=20
# 下列额度由代码硬锁，不读取 .env，避免误改后进入付费区间。
# GPT-5.4 综述正文的 UTC 日上限：账户免费额度 250k，项目只使用 200k 留余量。
# 达到此硬阀后不再发起写作调用，等待下一个 UTC 00:00 重置，避免产生付费用量。
REVIEW_DAILY_TOKEN_CAP=200000
# GPT-5.4-mini 论文分析的 UTC 日上限、单 Batch 上限、单篇输入上限。
LLM_DAILY_TOKEN_CAP=2000000
LLM_BATCH_TOKEN_CAP=600000
LLM_MAX_INPUT_TOKENS=200000
# 自动插图：从 paper_assets 挑选本章已引用论文的图表插入正文
REVIEW_INSERT_FIGURES=true
REVIEW_FIGURES_PER_SECTION=2
# 图题 rerank 相关度阈值（0-1，低于不插，避免插入无关图表）
REVIEW_FIGURE_MIN_SCORE=0.2
# 综述质量闸门（0-1）：单章无法溯源的量化句占比、因幻觉引用被剥离而失去来源的句子占比，超过即阻塞该章。
REVIEW_NUMERIC_UNSUPPORTED_MAX=0.2
REVIEW_UNSOURCED_CLAIM_MAX=0.15
# 每章 Track A 证据最多覆盖多少篇文献（单章总引用上限 18），控制单章提示词体积与额度消耗。
REVIEW_TRACK_A_MAX_DOCS=12
# 综述因日额度暂停（paused_quota）后，是否在下一个 UTC 00:00 自动续跑；0 = 需手动 resume。
REVIEW_AUTO_RESUME_QUOTA=1
# 单篇论文最多送进 LLM Batch 的次数，超过标 ANALYSIS_FAILED 不再重提交（防止坏稿反复烧额度）。
BATCH_MAX_ANALYSIS_ATTEMPTS=3
# daemon 心跳文件（默认 ${DATA_ROOT}/heartbeat，每 30s 更新，docker healthcheck 读取）。
DAEMON_HEARTBEAT_PATH=

# ── 5. 教材/书籍入库 ──────────────────────────────────────────────────
# 每份 PDF 最大页数（设为略低于你的 MinerU 套餐单任务页数上限）
BOOK_SPLIT_PAGES=180
# 每日定时入库：每天固定时间扫描教材输入目录，按 PDF 总页数预算处理
# （用完当晚额度就停，剩下留到下一晚；EPUB 走 pandoc 不占预算）
BOOK_INTAKE_TIME=03:00
BOOK_DAILY_PAGE_BUDGET=2000

# ── 6. 宿主机侧路径（只给 CLI / nightly_index.py / mcp_server.py 用）──
# 容器不读这一段：compose 已把容器内路径写死成 ./input_pdfs 这类相对路径。
# 只有在宿主机上直接敲 python review.py / cli.py 时才需要填，且要填绝对路径。
# 纯 Docker 用户整段留空即可。
INPUT_PDF_DIR=./input_pdfs
PROCESSED_PDF_DIR=./processed_pdfs
FAILED_PDF_DIR=./failed_pdfs
MINERU_OUTPUT_DIR=./mineru_output
OBSIDIAN_VAULT_DIR=./obsidian_vault
REVIEW_OUTPUT_DIR=./obsidian_vault/reviews
BOOK_INPUT_DIR=./input_books
BOOK_OUTPUT_DIR=./book_output

# MCP 启动器默认读取仓库根目录 .env、使用 python3，并保留当前代理设置。
# 只有集中管理 Key、使用专用虚拟环境或需要清理宿主机代理时才覆盖。
MCP_ENV_FILE=
MCP_PYTHON=
MCP_UNSET_PROXY=false

# Web 与 MCP HTTP 共用远程访问守卫；公网访问携带 Bearer token。
REMOTE_AUTH_TOKEN=
# 只填写实际反向代理的 IP/CIDR，逗号分隔；默认不信任任何转发头。
# 自行用 uvicorn 启动时加 --no-proxy-headers，由应用统一判断代理链。
REMOTE_TRUSTED_PROXY_CIDRS=
# Web API 跨域白名单（完整 Origin，逗号分隔，如 https://ui.example.com）。
# 默认留空 = 不启用 CORS，仅同源前端可调用；"*" 会被忽略，避免任意网站借本机 IP 身份调用 API。
# 同一白名单也用于 CSRF 校验：Web 与 MCP HTTP 的 POST/PUT/PATCH/DELETE 若带浏览器 Origin/Referer，
# 必须与请求 Host 同源或在此名单内，否则 403（curl/MCP 客户端不带 Origin，不受影响）。
WEB_CORS_ORIGINS=
# DNS rebinding 防护的 Host 白名单（Web 与 MCP HTTP 共用）。IP 字面量、localhost、本机主机名
# 与本机网卡地址（含 Tailscale 100.x、LAN）默认放行；用域名访问时在此逗号分隔列出，
# 如 dudu-sv.tail1234.ts.net；".tail1234.ts.net" 形式匹配其全部子域。单标签名（dudu-sv）默认放行。
# 填 "*" 关闭 Host 校验（不推荐）。修改后需重启 Web / MCP 服务。
REMOTE_ALLOWED_HOSTS=
# Web 综述检查点独立存储，默认 DB_PATH 同目录的 web_review_jobs.db。
# Web 任务注册器使用单进程运行，不要启动多个 uvicorn workers 共用此文件。
WEB_REVIEW_JOBS_DB_PATH=
# 发现库在 Web/CLI/MCP 联合检索中共用；空值时兼容 CITATION_NETWORK_DB_PATH。
TEST_CITATION_DB_PATH=
# 定时入库处理完的教材原件归档到 BOOK_PROCESSED_DIR；PDF 本身损坏（pypdf 连页数都读不出）
# 的移进 BOOK_FAILED_DIR 不再重试。⚠️ 两者都必须在 BOOK_INPUT_DIR 之外：已入库的书留在
# 输入目录里，每晚都会被重新计一遍页数预算，几本大部头就吃光当晚额度、新书永远排不上。
BOOK_PROCESSED_DIR=./processed_books
BOOK_FAILED_DIR=./failed_books
EXCEL_OUTPUT_PATH=./data/knowledge_base.xlsx
# 必须与 utils.Settings 的默认值、docker-compose.yml 的 DB_PATH 指同一个文件。
# 三处曾各写各的（./batch_tracking.db / ./data/batch_tracking.db / <repo>/batch_tracking.db），
# 一旦谁没被覆盖，夜间嵌入脚本就会去开一个空库然后报"无待索引文档"静默收工。
DB_PATH=./data/batch_tracking.db

# ── 7. 测试脚本专用（test_api.py 使用）────────────────────────────────
TEST_PDF_PATH=
TEST_OUTPUT_DIR=./test_output
