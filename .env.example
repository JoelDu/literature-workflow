# MinerU 在线 API 配置
MINERU_API_KEY=your_mineru_api_key_here

# 大模型 API 配置
DEEPSEEK_API_KEY=your_deepseek_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# SiliconFlow（优先于官方 DeepSeek；综述生成器的 embeddings/rerank 依赖它，必填）
SILICONFLOW_API_KEY=your_siliconflow_key
SILICONFLOW_API_BASE=https://api.siliconflow.cn/v1
DEEPSEEK_MODEL=deepseek-ai/DeepSeek-V3

# ── 网络代理与系统时区 (v2raya 默认 HTTP 端口通常为 20171 或 20172) ──
HTTP_PROXY=http://127.0.0.1:20171
HTTPS_PROXY=http://127.0.0.1:20171
ALL_PROXY=socks5://127.0.0.1:1080
TZ=Asia/Shanghai

# ── 宿主机磁盘挂载路径 (Docker 启动时会映射这些宿主机目录) ──
HOST_INPUT_PDF_DIR=./input_pdfs
HOST_PROCESSED_PDF_DIR=./processed_pdfs
HOST_FAILED_PDF_DIR=./failed_pdfs
HOST_MINERU_OUTPUT_DIR=./mineru_output
HOST_OBSIDIAN_VAULT_DIR=./obsidian_vault
HOST_EXCEL_OUTPUT_PATH=./knowledge_base.xlsx
HOST_DB_PATH=./batch_tracking.db

# 容器内部逻辑工作目录配置（无需修改，保持默认即可）
INPUT_PDF_DIR=./input_pdfs
PROCESSED_PDF_DIR=./processed_pdfs
FAILED_PDF_DIR=./failed_pdfs
MINERU_OUTPUT_DIR=./mineru_output
OBSIDIAN_VAULT_DIR=./obsidian_vault
EXCEL_OUTPUT_PATH=./knowledge_base.xlsx
DB_PATH=./batch_tracking.db

# 守护进程(Daemon) 运行配置
# 运行模式: realtime (定时扫描) 或 batch (定时打包打卡)
RUN_MODE=realtime
# 实时模式扫描间隔（分钟）
SCAN_INTERVAL_MINUTES=10
# Batch 模式及时入库调度（间隔驱动；旧的 BATCH_PREPARE_TIME/BATCH_FETCH_TIME_* 已废弃）
BATCH_SCAN_INTERVAL_MINUTES=30
BATCH_FETCH_INTERVAL_MINUTES=120

# 消息推送配置 (可选，填入 Server酱 / Bark / 飞书 / 钉钉 的 webhook URL)
WEBHOOK_URL=

# ── 综述生成器 (litreview) ──
# 嵌入模型（Qwen3-Embedding 跨中英检索强；换模型后需 review.py index --force 重建）
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
EMBEDDING_DIM=4096
# 重排序（向量召回 RERANK_CANDIDATES 条 → rerank 取 top-k，显著提升相关性排序）
RERANK_MODEL=Qwen/Qwen3-Reranker-8B
RERANK_ENABLE=true
RERANK_CANDIDATES=50
# 综述写作模型（SiliconFlow 托管）
REVIEW_MODEL=deepseek-ai/DeepSeek-V4-Pro
# 导出后自动增量更新向量索引 + 结构化元数据（enrich）
REVIEW_AUTO_INDEX=true
REVIEW_ENRICH_LLM=true
# 证据保留门槛（1-10 分）与每章节保留条数
REVIEW_MIN_SCORE=6
REVIEW_EVIDENCE_N=10
# 综述输出目录
REVIEW_OUTPUT_DIR=./obsidian_vault/reviews
# 自动插图：从 paper_assets 挑选本章已引用论文的图表插入正文
REVIEW_INSERT_FIGURES=true
REVIEW_FIGURES_PER_SECTION=2
# 图题 rerank 相关度阈值（0-1，低于不插，避免插入无关图表）
REVIEW_FIGURE_MIN_SCORE=0.2

# 测试脚本专用（test_api.py 使用）
TEST_PDF_PATH=
TEST_OUTPUT_DIR=./test_output
